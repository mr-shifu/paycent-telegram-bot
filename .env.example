# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Paycent API base URL
PAYCENT_API_URL=http://localhost:8080

# Internal API key for bot↔Paycent authentication
PAYCENT_BOT_API_KEY=your_bot_api_key_here

# Webhook mode (set to true in production, false for local polling)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=8443

# Log level: debug, info, warn, error
LOG_LEVEL=debug
